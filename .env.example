# Zentrail IDE environment overrides.
# Copy this file to `.env` and adjust as needed.

ZENTRAIL_HOST=127.0.0.1
ZENTRAIL_PORT=7341
ZENTRAIL_ENV=development
ZENTRAIL_DATA_DIR=.data

ZENTRAIL_PY_HOST=127.0.0.1
ZENTRAIL_PY_PORT=7342

# frontend <-> core
ZENTRAIL_GO_CORE_URL=http://127.0.0.1:7341
ZENTRAIL_PYTHON_RT_URL=http://127.0.0.1:7342
