{
  "name": "@zentrail/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Zentrail IDE desktop shell (Tauri v2 + React + TypeScript)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "vitest run"
  },
  "dependencies": {
    "@zentrail/settings": "workspace:*",
    "@zentrail/ui": "workspace:*",
    "@zentrail/terminal": "workspace:*",
    "@zentrail/git": "workspace:*",
    "@tauri-apps/api": "^2.1.1",
    "@tauri-apps/plugin-dialog": "^2.0.2",
    "@tauri-apps/plugin-fs": "^2.0.2",
    "@tauri-apps/plugin-notification": "^2.0.2",
    "@tauri-apps/plugin-shell": "^2.0.2",
    "@monaco-editor/react": "^4.6.0",
    "monaco-editor": "^0.52.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "lucide-react": "^0.460.0",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.1.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/node": "^20.16.0",
    "@vitejs/plugin-react": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  }
}
