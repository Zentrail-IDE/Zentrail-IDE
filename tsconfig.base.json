{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true,
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@zentrail/ui": ["packages/ui/src"],
      "@zentrail/editor": ["packages/editor/src"],
      "@zentrail/workspace": ["packages/workspace/src"],
      "@zentrail/terminal": ["packages/terminal/src"],
      "@zentrail/git": ["packages/git/src"],
      "@zentrail/settings": ["packages/settings/src"],
      "@zentrail/skill": ["packages/skill/src"],
      "@zentrail/agent": ["packages/agent/src"]
    }
  },
  "exclude": ["node_modules", "dist", "target"]
}
